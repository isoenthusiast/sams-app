enum ControlRiskRole {
  Primary
  Secondary
  Supporting
}

enum LOA {
  FirstLine
  SecondLine
  ThirdLine
}

enum ControlType {
  Administrative
  Procedural
  Analytical
  Behavioral
  Informational
  Engineering
}

enum AssessmentStatus {
  Planned
  InProgress
  Completed
  Cancelled
}

enum SampleStatus {
  Tested
  NotTested
}

enum SampleConclusion {
  Pass
  Fail
}

enum EmotionalDrive {
  EpicMeaning
  Development
  Empowerment
  Ownership
  SocialInfluence
  Scarcity
  Curiosity
  LossAvoidance
}

enum BadgeRarity {
  Common
  Uncommon
  Rare
  Epic
  Legendary
}

// ── Scrum/Kanban Backlog — Project management board ───────────────────
// Items flow: Backlog → SprintBacklog → InProgress → Completed.
// While InProgress, they move through stages: PlanDesign → Implement → Testing.
// PIP items use a separate workflow: Proposed → Approved → InProgress → Implemented → Closed.
enum BacklogItemType {
  Feature
  Request
  Bug
  Task
}

enum BacklogStatus {
  Backlog
  SprintBacklog
  InProgress
  Completed
}

enum PIPStatus {
  Proposed
  Approved
  InProgress
  Implemented
  Closed
}

enum DevelopmentStage {
  PlanDesign
  Implement
  Testing
}

model BacklogItem {
  id              String            @id @default(cuid())
  title           String
  description     String?
  type            BacklogItemType   @default(Task)
  status          BacklogStatus     @default(Backlog)
  stage           DevelopmentStage? // Only set when status = InProgress
  priority        Int               @default(0)
  justification   String?           // Why this should be done
  approach        String?           // How it should be done
  companyId       String?
  createdBy       String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // ── PIP fields (null for dev backlog items) ──
  isPIP            Boolean?          @default(false)
  pipStatus        PIPStatus?        // PIP-specific workflow
  processAreaId    String?           // PA this improvement belongs to
  targetDate       DateTime?         // When should this be done
  source           String?           // What triggered this (finding, assessment, SPO observation)
  riskAcceptance   Boolean           @default(false) // Deliberate acceptance of sub-ALARP risk
  alarpRationale   String?           // Why further reduction is not reasonably practicable

  processArea      ProcessArea?      @relation(fields: [processAreaId], references: [id])
  controlLinks     BacklogItemControl[]

  @@index([status])
  @@index([companyId])
  @@index([priority])
  @@index([isPIP])
  @@index([pipStatus])
  @@index([processAreaId])
}

// ── BacklogItemControl — M2M: PIP Item ⟷ Control ────────────────────
// Links improvement items to the controls they address.
// One control can spawn multiple PIPs; one PIP can address multiple controls.
model BacklogItemControl {
  id            String      @id @default(cuid())
  backlogItemId String
  controlId     String
  createdAt     DateTime    @default(now())
  backlogItem   BacklogItem @relation(fields: [backlogItemId], references: [id], onDelete: Cascade)
  control       Control     @relation(fields: [controlId], references: [id], onDelete: Cascade)

  @@unique([backlogItemId, controlId])
  @@index([backlogItemId])
  @@index([controlId])
}

// ── IMS Audit Evidence ──────────────────────────────────────────
// A single evidence-gathering event (interview, walkthrough, etc.)
// that may satisfy requirements from multiple standards simultaneously.
// Maps to AuditChecklist2Requirement via evidenceGroupId.
model AuditEvidence {
  id              String                          @id @default(cuid())
  title           String                          // e.g. "Interview — Instrument Engineer, Gas Detector Calibration"
  evidenceType    EvidenceType                    // Interview | DocumentReview | Walkthrough | GoSee | Sampling
  intervieweeName String?                         // e.g. "Jignesh JJ"
  plannedDate     DateTime                        // Scheduled date for audit plan
  actualDate      DateTime?                       // When it actually happened
  durationMinutes Int?                            // Duration in minutes
  interviewerName String?                         // Auditor name
  location        String?                         // e.g. "Control Room", "U-8600 Wax Plant"
  transcriptUrl   String?                         // Link to transcript (future: DeepSeek analysis)
  attachments     String?                         // Comma-separated or JSON array of attachment IDs
  notes           String?
  status          EvidenceStatus @default(Planned) // Planned → Conducted → Analysed
  createdAt       DateTime       @default(now())

  mappings        AuditChecklist2Requirement[]
}

// ── AuditChecklist2Requirement — Checklist Item ⟷ ISO/PMS Requirement ──
// Maps audit checklist items to their corresponding ISO/PMS requirements.
// Multiple checklist items can map to one requirement; one item can map to
// multiple requirements (integrated audit — e.g., instrument calibration
// satisfies QMS-7.1.5, EMS-9.1.1, and OHSMS-9.1.1 simultaneously).
// Optionally links to a specific SMDS Control for full traceability.
model AuditChecklist2Requirement {
  id              String        @id @default(cuid())
  checklistItemId String        // e.g. "1.1", "7.14" — from ISO_Internal_Audit_Checklist.md
  checklistText   String?       // Snapshot of the checklist item text
  auditStandard   String        // "ISO 9001" | "ISO 14001" | "ISO 45001" | "PMS"
  requirementRId  Int           // FK → Requirement.rId (@map("rID"))
  controlId       String?       // FK → Control.id (optional direct control link)
  evidenceNote    String?       // How this control/evidence satisfies the checklist item
  evidenceMethod  String?       // D | I | S | W | G
  evidenceGroupId String        // FK → AuditEvidence.id (shared for multi-clause evidence)
  mappedBy        String?       // Who did the mapping
  mappedAt        DateTime      @default(now())

  requirement     Requirement?  @relation(fields: [requirementRId], references: [rId])
  control         Control?      @relation(fields: [controlId], references: [id])
  evidence        AuditEvidence @relation(fields: [evidenceGroupId], references: [id])

  @@index([checklistItemId, auditStandard])
  @@index([requirementRId])
  @@index([controlId])
  @@index([evidenceGroupId])
}

// ── Enum: EvidenceType ─────────────────────────────────────────
enum EvidenceType {
  Interview
  DocumentReview
  Walkthrough
  GoSee
  Sampling
}

// ── Enum: EvidenceStatus ───────────────────────────────────────
enum EvidenceStatus {
  Planned
  Conducted
  Analysed
}

// ── Audit Checklist Template ───────────────────────────────────
// Reusable checklist template (e.g., "ISO 9001:2015", "Perform Maintenance Execution").
// Adopted per assessment by cloning items into AuditChecklistItem.
model AuditChecklistTemplate {
  id              String                      @id @default(cuid())
  name            String                      // e.g. "ISO 9001:2015 Quality Management System"
  description     String?                     // e.g. "Full ISO 9001 internal audit checklist"
  auditStandard   String                      // "ISO 9001" | "ISO 14001" | "ISO 45001" | "PMS" | "SEAM-MEX"
  companyId       String?
  createdAt       DateTime                    @default(now())

  items           AuditChecklistTemplateItem[]
  adoptedItems    AuditChecklistItem[]        @relation("TemplateToAdoptedItems")

  @@unique([name, companyId])
}

// ── Audit Checklist Template Item ───────────────────────────────
// A single checklist item within a template. Maps to requirements
// via AuditChecklist2Requirement (by checklistItemId string).
model AuditChecklistTemplateItem {
  id                  String                  @id @default(cuid())
  checklistItemId     String                  // e.g. "7.14"
  checklistText       String                  // the item text / question
  auditStandard       String                  // denormalized for query convenience
  sortOrder           Int                     @default(0)
  keyQuestions        String?                 // What the auditor should ask or look for
  whatGoodLooksLike   String?                 // Description of what compliant evidence looks like
  controlPoints       String?                 // Specific control points to verify
  evidenceRequirements String?                // What evidence is needed
  templateId          String
  template            AuditChecklistTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)

  clonedItems         AuditChecklistItem[]    // Instances in assessments

  @@unique([checklistItemId, templateId])
  @@index([templateId])
}

// ── Audit Checklist Item (per-assessment) ──────────────────────
// A checklist item cloned into a specific assessment, with
// compliance status tracked per audit round.
model AuditChecklistItem {
  id                  String                  @id @default(cuid())
  checklistItemId     String                  // e.g. "7.14" (same as template item)
  checklistText       String
  auditStandard       String
  complianceStatus    ComplianceStatus        @default(NotTested)
  auditorNotes        String?
  testedDate          DateTime?
  testedBy            String?
  evidenceMethod      String?                 // D | I | S | W | G
  keyQuestions        String?                 // Inherited from template
  whatGoodLooksLike   String?                 // Inherited from template
  controlPoints       String?                 // Inherited from template
  evidenceRequirements String?                // Inherited from template
  sortOrder           Int                     @default(0)
  assessmentId        String
  templateItemId      String                  // Source template item
  templateId          String?                 // Source template (denormalized for query)

  assessment       Assessment              @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  templateItem     AuditChecklistTemplateItem @relation(fields: [templateItemId], references: [id])
  template         AuditChecklistTemplate?   @relation("TemplateToAdoptedItems", fields: [templateId], references: [id])
  findings         Finding[]                // Findings linked to this checklist item
  controlLinks     AssessmentChecklistControl[]  // v1.10.1: Controls that satisfy this item
  /// SAMS-013: evidence-chain proposals targeting this checklist item.
  extractionProposals ExtractionProposal[]

  @@unique([checklistItemId, assessmentId])
  @@index([assessmentId])
  @@index([templateItemId])
}

// ── Enum: ComplianceStatus ─────────────────────────────────────
enum ComplianceStatus {
  NotTested
  Compliant
  NonCompliant
  NotApplicable
  Observation
}

// ── Assessment Checklist Control Junction ──────────────────────
// Explicit link between checklist items and the assigned controls
// that satisfy them. Scored by keyword relevance engine.
model AssessmentChecklistControl {
  id               String              @id @default(cuid())
  checklistItemId  String
  controlId        String
  assessmentId     String              // denormalized for query performance
  relevanceScore   Int                 @default(0)  // 0-100 keyword match score
  isLinked         Boolean             @default(false) // auditor confirmed the link
  createdAt        DateTime            @default(now())

  checklistItem    AuditChecklistItem  @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
  control          Control             @relation(fields: [controlId], references: [id], onDelete: Cascade)
  assessment       Assessment          @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([checklistItemId, controlId])
  @@index([checklistItemId])
  @@index([assessmentId])
}

// ── Pipeline tables (written via raw SQL by scripts/db; registered here so
// prisma db push never treats them as drift) ─────────────────────────────
// ReconcileClaim: multiworker claim gate + launcher lease
// (kb_control_reconcile.py / kb_map_v2.py / kb_cov_audit.py / launch_shards.py).
model ReconcileClaim {
  kbId        String   @id
  shard       Int
  claimedAt   DateTime @default(now())
  heartbeatAt DateTime @default(now())
}

// RequirementCoverageAudit: requirement coverage verdicts from the
// coverage-audit pipeline (cov_bootstrap.py / kb_cov_audit.py). Verdict labels
// match the Conclusion enum (FullyMet / PartiallyMet / NotMet).
model RequirementCoverageAudit {
  id                       String   @id
  companyId                String?
  processAreaId            String?
  requirementRId           Int
  requirementId            String?
  standard                 String?
  verdict                  String
  howMetEvidence           String?
  gapAnalysis              String?
  proposedControlStatement String?
  mappedControlCount       Int      @default(0)
  aiGenerated              Boolean  @default(true)
  modelName                String?  @map("model")
  worker                   String?
  covAt                    DateTime @default(now())

  @@index([processAreaId])
  @@index([requirementRId])
}

// SocStatementAudit: Statement of Compliance results from the SOC pipeline
// (soc_bootstrap.py / soc_worker.py). Verdict labels match the SocStatus enum
// (FullyComply / PartiallyComply / NotComply). The row IS the completion
// marker; workers write-through to Requirement.socStatus/socSummary.
model SocStatementAudit {
  id                  String   @id
  companyId           String?
  processAreaId       String?
  requirementRId      Int
  requirementId       String?
  standard            String?
  verdict             String
  summary             String?
  source              String   @default("audit-bootstrap")
  covAuditBackfilled  Boolean  @default(false)
  aiGenerated         Boolean  @default(true)
  modelName           String?  @map("model")
  worker              String?
  socAt               DateTime @default(now())

  @@index([processAreaId])
  @@index([requirementRId])
}

// TestClaim: test-plan orchestration claim gate (test_plan_supervisor.py /
// test_plan_worker.py). Every test is a unit of work; tests group into chains
// claimed whole by one worker. status: available|claimed|deferred|done|blocked.
model TestClaim {
  testId     String   @id
  chainId    String
  area       String
  mode       String   @default("ui")
  status     String   @default("available")
  workerId   String?
  leaseUntil DateTime?
  attempts   Int      @default(0)
  result     String?
  evidence   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())

  @@index([status])
  @@index([chainId])
}

// TestWorker: worker liveness rows (heartbeat) for the test-plan watchdog.
model TestWorker {
  workerId  String   @id
  pid       Int?
  startedAt DateTime @default(now())
  lastBeat  DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// Conversation Fabric (SAMS-004, Phase 2a): threaded comments + evidence-request
// pipeline. One polymorphic `Comment` model (entityType+entityId, mirroring the
// AttachmentMapping destTable/recId convention) + a structured EvidenceRequest
// DRL unit with its own state machine. Append-only v1 (no edit/delete).
// ─────────────────────────────────────────────────────────────────────────────

enum CommentAuthorPlane {
  Provider
  Client
}

enum CommentVisibility {
  Internal
  SharedWithClient
}

model Comment {
  id              String              @id @default(cuid())
  /// Polymorphic target: `Finding` | `EvidenceRequest` (v1). Enum extension later.
  entityType      String
  entityId        String
  /// Flat threads — one level. Root comments have null here; replies reference
  /// their parent root comment. Append-only v1 (no edit/delete).
  parentCommentId String?
  parentComment   Comment?            @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies         Comment[]           @relation("CommentReplies")
  authorUserId    String
  author          User                @relation(fields: [authorUserId], references: [id])
  /// Derived from the session (providerRole → Provider), never client-supplied.
  authorPlane     CommentAuthorPlane  @default(Provider)
  visibility      CommentVisibility   @default(Internal)
  body            String
  companyId       String?
  createdAt       DateTime            @default(now())

  @@index([entityType, entityId])
  @@index([companyId])
  @@index([authorUserId])
}

enum EvidenceRequestStatus {
  Draft
  Requested
  Submitted
  Accepted
  Rejected
  NotApplicable
}

model EvidenceRequest {
  id                  String               @id @default(cuid())
  companyId           String?
  assessmentId        String?
  assessment          Assessment?          @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  requirementRId      Int?
  controlId           String?
  title               String
  instructions        String
  requestedByUserId   String
  requestedBy         User                 @relation("EvidenceRequestRequestedBy", fields: [requestedByUserId], references: [id])
  requestedFromUserId String
  requestedFrom       User                 @relation("EvidenceRequestRequestedFrom", fields: [requestedFromUserId], references: [id])
  dueDate             DateTime?
  status              EvidenceRequestStatus @default(Draft)
  submittedNote       String?
  reviewNote          String?
  submittedAt         DateTime?
  reviewedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([companyId, status])
  @@index([requestedFromUserId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// In-App Notifications (SAMS-006, Phase 2c): stored fabric events. Event set
// v1: EvidenceRequested (→ requestee), EvidenceSubmitted (→ requester),
// EvidenceReviewed (→ requestee), CommentShared (→ entity participants,
// excluding the author). Overdue actions are computed at READ time (a synthetic
// banner in the bell-count query) — NEVER stored as rows, so no scheduler and no
// event for a state. Outbound transport (email/webhook) is explicitly Phase 3.
// ─────────────────────────────────────────────────────────────────────────────
enum NotificationType {
  EvidenceRequested
  EvidenceSubmitted
  EvidenceReviewed
  CommentShared
  /// SAMS-009 sweep: an Action crossed its targetDate (newly overdue) — posted
  /// to the company channel + in-app to the company's client Admins.
  ActionOverdue
  /// SAMS-014 MIC Ritual: a Process Area is newly due for SOC attestation —
  /// emitted during the weekly-digest sweep to the company's SPOs (client
  /// Admin/Assessor/Superuser of that company), deduped per cadence window.
  MicAttestationDue
}

model Notification {
  id              String           @id @default(cuid())
  recipientUserId String
  /// Recipient of the notification — the only user whose rows are ever read
  /// (reads are strictly userId-scoped; never company-materialised in a list).
  recipient       User             @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  type            NotificationType
  /// Polymorphic target (mirrors the Comment entityType convention):
  /// `EvidenceRequest` | `Finding` (v1). Deep-links are resolved at read-time.
  entityType      String
  entityId        String
  title           String // ≤200
  body            String // ≤500
  readAt          DateTime?
  companyId       String? // denormalized for the company-scoped overdue banner
  createdAt       DateTime         @default(now())
  /// Outbound audit rows (SAMS-009): webhook deliveries that referenced this
  /// in-app notification (nullable — company-channel/digest posts set null).
  deliveries      NotificationDelivery[]

  @@index([recipientUserId, readAt])
  @@index([companyId])
}

// ── SAMS-013: Transcript → Evidence Chain (Phase 4, Feature A) ─────────
// Human-confirmed per checklist item: the DeepSeek pipeline proposes evidence
// excerpts + suggested actions from a transcript; the assessor confirms
// (optionally edits) / rejects EACH before anything links. NOTHING links while
// status = Proposed — the proposal record IS the attestation trail.
//
// PROPOSED → Confirmed: verify_step links evidence (attachment on the
// checklist-item audit) + creates a draft Action. PROPOSED → Rejected: recorded
// (never resurfaced). confirmedBy/confirmedAt and rejectedBy/rejectedAt form the
// audit trail of who decided and when.
enum ProposalStatus {
  Proposed
  Confirmed
  Rejected
}

model ExtractionProposal {
  id                  String         @id @default(cuid())
  status              ProposalStatus @default(Proposed)
  /// Source transcript (entryType=Transcript) this evidence was extracted from.
  knowledgebaseId     String
  knowledgebase       Knowledgebase  @relation(fields: [knowledgebaseId], references: [kID], onDelete: Cascade)
  /// Assessment whose checklist the proposal targets (denormalized for scoping).
  assessmentId        String
  assessment          Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  /// Target checklist item (the audit the evidence lands on).
  auditChecklistItemId String
  auditChecklistItem  AuditChecklistItem @relation(fields: [auditChecklistItemId], references: [id], onDelete: Cascade)
  /// Tenant scope — denormalized; by construction equals the transcript's company
  /// AND the checklist item's assessment company (cross-tenant is impossible).
  companyId           String
  company             Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Transcript span reference (char offsets into knowledgeContent).
  spanStart           Int
  spanEnd             Int
  /// The evidence excerpt (the extracted transcript text). Editable on confirm.
  evidenceExcerpt     String
  /// Optional AI-suggested remediation action (confirmed → draft Action).
  suggestedAction     String?
  /// Attestation trail.
  proposedBy          String         @default("AI") // who proposed (AI in Phase-4)
  proposedByUserId    String?        // the assessor who ran extraction (audit only)
  confirmedByUserId   String?        // who confirmed (nullable = still proposed)
  confirmedAt         DateTime?
  rejectedByUserId    String?        // who rejected (nullable = still proposed)
  rejectedAt          DateTime?
  /// Transcript title snapshot for display without a join.
  transcriptTitle     String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([companyId, status])
  @@index([assessmentId, status])
  @@index([auditChecklistItemId])
  @@index([knowledgebaseId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Outbound Notifications (SAMS-009, Phase 3a, Feature B): a per-company webhook
// transport (Slack-compatible `{"text": …}`) + a delivery audit trail. The
// same event set as in-app (EvidenceRequested/Submitted/Reviewed, CommentShared)
// is posted at the COMPANY-channel level once per event (never per-recipient);
// plus a CRON_SECRET-gated sweep + weekly digest. Delivery is fire-and-record:
// `postCompanyWebhook` NEVER throws (SAMS-006 fault-containment rule applies —
// see src/lib/notifications.ts). No retry queue in v1.
// ─────────────────────────────────────────────────────────────────────────────
enum NotificationDeliveryChannel {
  webhook
}

enum NotificationDeliveryStatus {
  sent
  failed
}

model NotificationDelivery {
  id             String                      @id @default(cuid())
  /// Nullable — set when the delivery maps to a single in-app Notification;
  /// null for company-channel / sweep / digest posts (a state is posted once,
  /// not once per recipient).
  notificationId String?
  notification   Notification?              @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  channel        NotificationDeliveryChannel @default(webhook)
  companyId      String
  company        Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status         NotificationDeliveryStatus
  /// HTTP response code from the webhook POST (null when the request could not
  /// be made / timed out — those record status=failed with responseCode null).
  responseCode   Int?
  attemptedAt    DateTime                    @default(now())
  /// The `{text}` payload body, truncated to ≤200 chars (audit trail only —
  /// never contains the webhook URL itself, which is write-only).
  payloadPreview String?

  @@index([companyId])
  @@index([notificationId])
  @@index([status, attemptedAt])
}
