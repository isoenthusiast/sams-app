model Risk {
  id                   String       @id @default(cuid())
  riskID               String       @unique          // Manual text ID (auto-suggested RSK-001, editable)
  currentImpact        String                         // Impact if risk materialises
  currentLikelihood    String                         // Likelihood of materialisation
  objectives           String?                        // Objectives at risk
  unmitigatedImpact    String?                        // Impact before controls
  unmitigatedLikelihood String?                       // Likelihood before controls
  riskEnvExternal      String?                        // External risk environment
  riskEnvInternal      String?                        // Internal risk environment
  riskEvent            String                         // Risk event description
  rootCauses           String?                        // Root causes
  consequences         String                         // Consequences if materialised
  riskCategoryId       String?                        // FK → RiskCategory (Level-3)
  processAreaId        String?                        // FK → ProcessArea (denormalized)
  createdById          String?                        // FK → User
  updatedById          String?                        // FK → User
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  riskCategory         RiskCategory? @relation(fields: [riskCategoryId], references: [id])
  metrics              RiskMetrics[]
  controlLinks         ControlRisk[]

  @@index([riskID])
  @@index([riskCategoryId])
  @@index([processAreaId])
}

model RiskMetrics {
  id                    String   @id @default(cuid())
  riskId                String
  defWithinAppetite     String?
  defNearAppetite       String?
  defOutsideAppetite    String?
  currentStatus         String?  // Current appetite status
  statusUpdatedOn       DateTime?
  createdById           String?
  updatedById           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  risk                  Risk     @relation(fields: [riskId], references: [id])

  @@index([riskId])
}

model ControlRisk {
