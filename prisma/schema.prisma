  riskId      String
  controlId   String
  role        ControlRiskRole? // Primary / Secondary / Supporting (optional)
  riskWeight  Int?
  risk        Risk             @relation(fields: [riskId], references: [id])
  control     Control          @relation(fields: [controlId], references: [id])

  @@unique([riskId, controlId])
  @@index([riskId])
  @@index([controlId])
