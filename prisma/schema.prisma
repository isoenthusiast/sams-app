  Knowledge
  Transcript
}

// ── Tagging — company-scoped, reusable across KB entries ──────────
// DEFERRED (ADR-0004 post-deploy, 2026-08-29): `companyId` is nullable, so
// @@unique([name, companyId]) lets duplicate (name, NULL) rows through (Postgres
// treats NULLs as distinct in a unique index). Non-null enforcement is deferred
// (shared prod DB, additive-only — a NOT NULL could fail on existing rows).
// Contract: the transcript upload route always sets companyId (400s without it),
// so tags are always company-scoped at the app layer. Verified 2026-08-29: 0
// NULL-companyId Tag rows in prod.
model Tag {
  id        String            @id @default(cuid())
  name      String
  companyId String?
  createdAt DateTime          @default(now())
  knowledge KnowledgebaseTag[]

  @@unique([name, companyId])
  @@index([name])
  @@index([companyId])
}

// M:N junction Knowledgebase <-> Tag
// DEFERRED (ADR-0004 post-deploy, 2026-08-29): `onDelete: Cascade` on kbase/tag
// is declared here but NOT materialized as a DB FK — scripts/add_transcript_tagging.ts
// adds no FK (shared prod DB, additive-only rule). The generated Prisma client
// therefore *thinks* cascade exists while Postgres has none. The DELETE route
// compensates with an explicit knowledgebaseTag.deleteMany(...) before deleting
// the entry ("no DB cascade assumed"). Run `npm run db:parity` to surface drift —
// the two KnowledgebaseTag `AddForeignKey` statements are the known, deferred gap.
model KnowledgebaseTag {
  id        String        @id @default(cuid())
  kID       String
  tagId     String
  createdAt DateTime      @default(now())
  kbase     Knowledgebase @relation(fields: [kID], references: [kID], onDelete: Cascade)
  tag       Tag           @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([kID, tagId])
  @@index([tagId])
}

model MapArt2Know {
  id        String   @id @default(cuid())
  mapA2KID  String   @unique
  artName   String
  artID     String
  kID       String
  whyToMap  String?
  createdAt DateTime @default(now())

  @@index([kID])
  @@index([artID])
}

// ── Requirement — SMDS ICOP Statutory Requirements ─────────────────────
// Imported from frontline library/mRequirement.csv.
// rID is the canonical requirement identifier (from source data, not auto-generated).
// processAreaId is backfilled from ProcessArea via pID → ProcessArea.pId mapping.
model Requirement {
  rId                 Int                      @id @map("rID")
  standard            String
  pId                 String                   @map("pID")
  processAreaId       String?
  requirementId       String
  clauseContent       String
  intentOutcome       String
  clauseApplicability String
  references          String?
  applicable          Boolean                  @default(true)
  /// Standing Statement of Compliance: whether the requirement's mapped controls
  /// cover the requirement (design effectiveness), with a human summary (≤1000 chars).
  socStatus           SocStatus?
  socSummary          String?
  createdAt           DateTime                 @default(now())
  companyId           String?
  processArea         ProcessArea?             @relation(fields: [processAreaId], references: [id])
  controlMappings     MapControl2Requirement[]
  assuranceProtocols  AssuranceProtocol[]
  auditMappings       AuditChecklist2Requirement[]
  documentMappings    MapRequirement2Document[]
  conclusions         RequirementConclusion[]

  @@unique([requirementId, processAreaId, companyId])
  @@index([processAreaId])
  @@map("Requirement")
}

// ── MapControl2Requirement — M2M: Control ⟷ Requirement ──────────────
// One requirement can map to many controls; one control to many requirements.
// processAreaId provides the initial mapping anchor (same PA = potential link).
model MapControl2Requirement {
  id             String      @id @default(cuid())
  controlId      String
  requirementRId Int
  processAreaId  String?
  mandatory      Boolean     @default(false) // PMS: control is essential to satisfy this requirement (if absent, requirement fails)
  aiGenerated    Boolean?    // true when row was created by the AI mapping pipeline (kb_map_v2.py)
  createdAt      DateTime    @default(now())
  control        Control     @relation(fields: [controlId], references: [id], onDelete: Cascade)
  requirement    Requirement @relation(fields: [requirementRId], references: [rId], onDelete: Cascade)

  @@unique([controlId, requirementRId])
  @@index([controlId])
  @@index([requirementRId])
  @@index([processAreaId])
  @@map("MapControl2Requirement")
}

// ── Gamification Maturity Stages ─────────────────────────────────────
// Tracks which stage each company is at in the gamification journey.
// 0=Compliance, 1=Recognition, 2=Growth, 3=Play.
model GamificationStage {
