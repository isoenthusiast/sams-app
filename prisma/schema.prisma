generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                 @id @default(cuid())
  name                 String
  username             String                 @unique
  email                String?
  passwordHash         String
  role                 Role                   @default(Assessor)
  /// Provider plane (managed GRA SaaS, Phase 0): orthogonal to `role`.
  /// null = not provider staff. Additive only — no backfill.
  providerRole         ProviderRole?
  positionId           String?
  position             Position?              @relation(fields: [positionId], references: [id])
  companyId            String?
  managerName          String?
  managerUsername      String?
  organisationIndicator String?
  preferredName        String?
  active               Boolean                @default(false)
  /// Force a password change on next credentials login (SAMS-012). Wizard-provisioned
  /// users (temp password) get this set; credentials login with the flag redirects to
  /// `/change-password` until it is cleared. Additive, default false — no backfill.
  mustChangePassword   Boolean                @default(false)
  sortOrder            Int                    @default(0)
  createdAt            DateTime               @default(now())
  totalPoints          Int                    @default(0)
  dailyPointStreak     Int                    @default(0)
  lastActivityDate     DateTime?
  confidenceInfluencer Boolean                @default(false)
  assessments          Assessment[]           @relation("AssessmentLeadAssessor")
  assessmentRoles      AssessmentAssessor[]   @relation("UserToAssessment")
  emotionalDrives      EmotionalDriveMetric[]
  milestones           Milestone[]
  points               PointTransaction[]
  achievements         UserAchievement[]
  roleMappings         UserRoleMapping[]
  userCompanies        UserCompany[]
  comments             Comment[]
  evidenceRequestsBy   EvidenceRequest[]  @relation("EvidenceRequestRequestedBy")
  evidenceRequestsFrom EvidenceRequest[]  @relation("EvidenceRequestRequestedFrom")
  /// Client Management Responses authored by this user (SAMS-005).
  managementResponses  Finding[]          @relation("FindingManagementResponse")
  /// In-app Notifications received by this user (SAMS-006, Phase 2c).
  notifications        Notification[]     @relation("NotificationRecipient")
  /// Public read-only API keys this user created (SAMS-011, Phase 3b).
  apiKeys              ApiKey[]           @relation("ApiKeyCreatedBy")
  /// MIC attestations this user signed (SAMS-014, Phase 4 Feature B).
  micAttestations      MicAttestation[]   @relation("MicAttestationAttestedBy")
}

model ActivityLog {
  id                String             @id @default(cuid())
  timestamp         DateTime           @default(now())
  description       String
  activityType      String
  username          String
  refTable          String?
  refRecord         String?
  beforeData        Json?
  afterData         Json?
  createdAt         DateTime           @default(now())
  pointTransactions PointTransaction[]

  @@index([timestamp])
  @@index([username])
  @@index([activityType])
  @@index([refTable])
}

model ActivityLogType {
  id           String   @id @default(cuid())
  activityType String   @unique
  refTable     String?
  description  String?
  createdAt    DateTime @default(now())
}

model AssuranceActivityType {
  id               String                           @id @default(cuid())
  name             String                           @unique
  description      String?
  defaultLOA       LOA
  createdAt        DateTime                         @default(now())
  assessments      Assessment[]
  templateLinkages AssessmentTemplateActivityType[]
}

// ── AssuranceProtocol — Audit checklist items tied to Requirements ───
model AssuranceProtocol {
  id                          String      @id @default(cuid())
  requirementId               String      // e.g., "Air Quality - 1"
  rId                         Int         // FK to Requirement.rID
  processAreaName             String?
  pId                         String?
  reqNo                       String
  standard                    String?
  process                     String?
  objective                   String?
  risk                        String?
  intent                      String?
  requirement                 String?
  keyQuestions                String?
  whatGoodLooksLike           String?
  controlPoints               String?
  linkageToOtherRequirements  String?
  link                        String?
  digitalLibrary              String?
  url                         String?
  companyId                   String?
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt

  requirementRel              Requirement @relation(fields: [rId], references: [rId], onDelete: Cascade)

  @@index([rId])
  @@index([requirementId])
  @@index([processAreaName])
  @@map("AssuranceProtocol")
}

// ── Standard — Management system standards (ISO, ICOP, etc.) ─────────
model Standard {
  id                  String        @id @default(cuid())
  standard            String
  standardDescription String?
  sequenceNo          Int           @default(0)
  companyId           String?
  createdAt           DateTime      @default(now())
  processAreas        ProcessArea[]

  @@unique([standard, companyId])
  @@map("Standard")
}

model ProcessArea {
  id              String             @id @default(cuid())
  name            String
  abbreviatedName String?
  description     String?
  createdAt       DateTime           @default(now())
  pId             String?
  standard        String?
  standardId      String?            @map("StandardID")
  companyId       String?
  standardRef     Standard?          @relation(fields: [standardId], references: [id])
  controls        Control[]
  subProcesses    SubProcess[]
  badges          AchievementBadge[]
  requirements    Requirement[]
  assessments     Assessment[]

  // ── MIC (Management in Control) ──
  micStatement         String?
  micStatementUpdatedAt DateTime?

  pipItems         BacklogItem[]     // PIP items for this PA
  /// MIC attestation records that pin this PA's posture at a point in time (SAMS-014).
  micAttestations  MicAttestation[]

  @@unique([name, companyId])
  @@index([standardId])
}

model SubProcess {
  id                    String                @id @default(cuid())
  name                  String
  description           String?
  processAreaId         String
  createdAt             DateTime              @default(now())
  companyId             String?
  processArea           ProcessArea           @relation(fields: [processAreaId], references: [id])
  controlSubProcesses   ControlSubProcess[]
}

// Many-to-many: a Control can belong to multiple SubProcesses (e.g. the same
// control logic applies across ISO 9001, ISO 14001, ISO 45001 without
// duplicating the control record). The junction's isPrimary flag marks the
// "primary" sub-process for display and filtering purposes.
model ControlSubProcess {
  id           String     @id @default(cuid())
  controlId    String
  subProcessId String
  isPrimary    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  control      Control    @relation(fields: [controlId], references: [id], onDelete: Cascade)
  subProcess   SubProcess @relation(fields: [subProcessId], references: [id], onDelete: Cascade)

  @@unique([controlId, subProcessId])
  @@index([controlId])
  @@index([subProcessId])
}

model Control {
  id                  String                             @id @default(cuid())
  name                String
  statement           String
  controlType         ControlType
  processAreaId       String?
  isHsseCritical      Boolean                            @default(false)
  ramRating           String?
  riskWeight          Int                                @default(1)
  /// Authoritative marker that this control was processed by the control →
  /// requirement mapping pipeline (stamped with 0..N mapping rows).
  mappedAt            DateTime?
  rawHealthScore      Int                                @default(80)
  lastTestedDate      DateTime?
  lastTestResult      String?
  createdAt           DateTime                           @default(now())
  controlRef          String?
  sourceFile          String?
  practiceDocument    String?
  controlTypeDetail   String?
  csfWho              String?
  csfWhat             String?
  csfWhen             String?
  csfWhere            String?
  csfWhy              String?
  csfHow              String?
  csfEvidence         String?
  keyActivities       String?
  riskAddressed       String?
  testingApproach     String?
  uncertainFlags      String?
  knowledge           String?                            // Admin-only: audit knowledge / briefing notes
  standard            String?
  pId                 String?
  Requirements        String?
  companyId           String?
  // ── CSF v2.0 (2026-08-06) ──────────────────────────────────────────
  controlOwner        String?                            // RASCI "A" — accountable person, distinct from csfWho (the performer)
  assuranceCadence    String?                            // How often tested/assured (e.g. "Quarterly"), distinct from csfWhen (operational timing)
  effectivenessCriteria String?                          // Measurable standard for what "effective" means
  practiceDocumentId  String?                            // FK → Knowledgebase.kID — structured procedure link
  // ──────────────────────────────────────────────────────────────────────
  controlAssignments  ControlAssignment[]
  controlSubProcesses ControlSubProcess[]
  templateLinkages    AssessmentTemplateControlLinkage[]
  requirementMappings MapControl2Requirement[]
  pipLinks            BacklogItemControl[]
  auditMappings       AuditChecklist2Requirement[]
  checklistControlLinks AssessmentChecklistControl[] // v1.10.1
  processArea         ProcessArea?                       @relation(fields: [processAreaId], references: [id])
  riskMappings        ControlRisk[]                      // v1.12.0

  @@unique([name, companyId])
  @@index([controlRef])
}

model AssessmentTemplate {
  id              String                             @id @default(cuid())
  name            String
  description     String?
  createdAt       DateTime                           @default(now())
  updatedAt       DateTime                           @updatedAt
  companyId       String?
  activityTypes   AssessmentTemplateActivityType[]
  controlLinkages AssessmentTemplateControlLinkage[]

  @@unique([name, companyId])
}

model AssessmentTemplateControlLinkage {
  id         String             @id @default(cuid())
  templateId String
  controlId  String
  createdAt  DateTime           @default(now())
  control    Control            @relation(fields: [controlId], references: [id], onDelete: Cascade)
  template   AssessmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, controlId])
  @@index([templateId])
  @@index([controlId])
}

model AssessmentTemplateActivityType {
  id             String                @id @default(cuid())
  templateId     String
  activityTypeId String
  createdAt      DateTime              @default(now())
  activityType   AssuranceActivityType @relation(fields: [activityTypeId], references: [id], onDelete: Cascade)
  template       AssessmentTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, activityTypeId])
  @@index([templateId])
  @@index([activityTypeId])
}

model Assessment {
  id                 String                @id @default(cuid())
  activityTypeId     String
  name               String
  assessorId         String
  startDate          DateTime
  endDate            DateTime?
  loa                LOA
  status             AssessmentStatus      @default(Planned)
  companyId          String?
  processAreaId      String?   // direct PA link (coverage audits + future grouping; UI falls back to control assignments when null)
  createdAt          DateTime              @default(now())

  // ── Terms of Reference (TOR) ──
  objective        String?   // Audit objective — why we're doing this
  scope            String?   // Scope and references — what's being assessed
  sponsor          String?   // Report sponsor — who commissioned the audit
  methodology      String?   // Audit methodology — how we'll assess
  keyFocus         String?   // Key focus areas & comments
  reportIssueDate  DateTime? // When the report will be issued

  assessor           User                  @relation("AssessmentLeadAssessor", fields: [assessorId], references: [id])
  activityType       AssuranceActivityType @relation(fields: [activityTypeId], references: [id])
  processArea        ProcessArea?          @relation(fields: [processAreaId], references: [id])
  controlAssignments ControlAssignment[]
  samples            Sample[]
  findings           Finding[]
  aacts              Aact[]
  assessorLinks      AssessmentAssessor[]  @relation("AssessmentToAssessor")
  checklistItems     AuditChecklistItem[]
  checklistControlLinks AssessmentChecklistControl[] // v1.10.1
  requirementConclusions RequirementConclusion[]
  evidenceRequests       EvidenceRequest[]
  /// SAMS-013: evidence-chain proposals targeting this assessment's checklist.
  extractionProposals    ExtractionProposal[]
}

// Many-to-many: an Assessment can have multiple Assessors.
// Kept separate from the lead assessor (assessorId) for backward compatibility.
model AssessmentAssessor {
  id           String     @id @default(cuid())
  assessmentId String
  userId       String
  createdAt    DateTime   @default(now())
  assessment   Assessment @relation("AssessmentToAssessor", fields: [assessmentId], references: [id], onDelete: Cascade)
  user         User       @relation("UserToAssessment", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, userId])
  @@index([assessmentId])
  @@index([userId])
}

// Assigns Controls to an Assessment from the assessment UI.
// Many-to-many: an Assessment can have many Controls, a Control can be
// assigned to many Assessments.
model ControlAssignment {
  id                 String         @id @default(cuid())
  assessmentId       String
  controlId          String
  // null = "Select One" (not yet assessed).
  effective          Effectiveness?
  // Set whenever `effective` is changed, and only then.
  effectiveUpdatedAt DateTime?
  testNotes          String?         // Auditor notes from testing this control
  testMethod         String?         // Document Review | Interview | Observation | Sample | Walkthrough
  createdAt          DateTime       @default(now())
  control            Control        @relation(fields: [controlId], references: [id], onDelete: Cascade)
  assessment         Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  samples            Sample[]       // Evidence linked to this control

  @@unique([assessmentId, controlId])
  @@index([assessmentId])
  @@index([controlId])
}

enum Effectiveness {
  Effective
  NotEffective
}

enum Conclusion {
  FullyMet
  PartiallyMet
  NotMet
}

enum SocStatus {
  FullyComply
  PartiallyComply
  NotComply
}

model RequirementConclusion {
  id               String     @id @default(cuid())
  assessmentId     String
  requirementRId   Int
  conclusion       Conclusion
  narrative        String?
  lastAssessedDate DateTime?
  createdAt        DateTime   @default(now())
  assessment       Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  requirement      Requirement @relation(fields: [requirementRId], references: [rId], onDelete: Cascade)

  @@unique([assessmentId, requirementRId])
  @@index([assessmentId])
  @@index([requirementRId])
}

model SampleType {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  samples   Sample[]
}

model RecordSourceType {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  samples   Sample[]
}

model Sample {
  id               String            @id @default(cuid())
  assessmentId     String
  sampleTypeId     String?
  recordSourceId   String?
  recordReference  String?
  controlEffective Boolean           @default(false)
  comment          String?
  status           SampleStatus      @default(NotTested)
  conclusion       SampleConclusion?
  evidenceUrl      String?
  createdAt        DateTime          @default(now())
  recordSource     RecordSourceType? @relation(fields: [recordSourceId], references: [id])
  sampleType       SampleType?       @relation(fields: [sampleTypeId], references: [id])
  controlAssignmentId String?        // Link to specific control being tested
  controlAssignment   ControlAssignment? @relation(fields: [controlAssignmentId], references: [id], onDelete: SetNull)
  assessment       Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  findings         Finding[]
}

// A Finding is raised against an Assessment (required) and may optionally be
// tied to the specific Sample it was observed from. Findings use a
// human-readable running-number id (FID-XXXXXX) instead of a cuid, generated
// in application code (see src/lib/findings.ts).
model Finding {
  id              String          @id
  assessmentId    String
  sampleId        String?
  checklistItemId String?         // FK → AuditChecklistItem (audit finding trace)
  description     String
  details         String?
  controlIds      String?
  risks           String?
  repeat          Boolean         @default(false)
  severity        FindingSeverity
  createdAt       DateTime        @default(now())
  // ── Requirement-based findings (v1.11.2) ─────────────────────────────
  requirementRId  Int?            @map("requirementRId")
  processAreaId   String?         // denormalized for query performance
  riskDescription String?
  rootCause       String?
  recommendation  String?
  // ── Risk-based findings (v1.12.0) ────────────────────────────────────
  riskID          String?         // FK → Risk.riskID (three-way traceability, plain scalar)
  // ── Management Response (SAMS-005, Client Portal) ─────────────────────
  // A named, dated, attributable client response to a finding. Additive +
  // nullable, no backfill. Editable by client Assessor+ roles of that company.
  managementResponse     String?    // ≤2000 chars — the client's response body
  managementResponseAt   DateTime?  // when the response was saved
  managementResponseById String?    // FK → User (who responded)
  // ──────────────────────────────────────────────────────────────────────
  assessment      Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  sample          Sample?         @relation(fields: [sampleId], references: [id], onDelete: SetNull)
  checklistItem   AuditChecklistItem? @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)
  managementResponseBy User?      @relation("FindingManagementResponse", fields: [managementResponseById], references: [id], onDelete: SetNull)
  actions         Action[]

  @@index([assessmentId])
  @@index([sampleId])
  @@index([checklistItemId])
  @@index([requirementRId])
  @@index([processAreaId])
  @@index([managementResponseById])
}

// An Action is a remediation item tied to exactly one Finding.
model Action {
  id                      String    @id @default(cuid())
  actionId                String?   @unique
  findingId               String
  actionDescription       String
  actionDetails           String?
  actionTaken             String?
  actionParty             String?
  auditee                 String?
  createdDate             DateTime  @default(now())
  targetDate              DateTime?
  apAgreed                Boolean   @default(false)
  originalTargetDate      DateTime?
  numberOfExtensions      Int       @default(0)
  actionClosureEffective  Boolean   @default(false)
  actionClosureApprovedBy String?
  closureDate             DateTime?
  closureEvidence         String?
  // ── Risk linkage (v1.12.0) ───────────────────────────────────────────
  riskID                  String?   // FK → Risk.riskID
  finding                 Finding   @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId])
}

model Attachment {
  id          String              @id @default(cuid())
  description String?
  fileName    String
  filePath    String
  fileSize    Int?
  uploadedBy  String
  uploadDate  DateTime            @default(now())
  companyId   String?
  mappings    AttachmentMapping[]
}

model AttachmentMapping {
  id           String     @id @default(cuid())
  attachmentId String
  destTable    String
  recId        String
  attachment   Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@index([destTable, recId])
  @@index([attachmentId])
}

enum FindingSeverity {
  Low
  Medium
  High
  Serious
}

model AchievementBadge {
  id                String            @id @default(cuid())
  badgeName         String
  description       String
  badgeType         String            @default("track") // "track" | "role" | "special"
  icon              String
  badgeImage        String?
  backgroundPrompt  String?
  foregroundPrompt  String?
  designConfig      Json?
  imageFormat       String?           // "svg" | "png"
  emotionalDrive    EmotionalDrive
  rarity            BadgeRarity       @default(Uncommon)
  level             String?
  processAreaId     String?
  processArea       ProcessArea?      @relation(fields: [processAreaId], references: [id])
  pointsRequired    Int?
  controlsChecked   Int?
  streakDays        Int?
  achievementType   String
  createdAt         DateTime          @default(now())
  userAchievements  UserAchievement[]

  @@unique([badgeName, level])
  @@index([emotionalDrive])
  @@index([processAreaId])
  @@index([level])
  @@index([badgeType])
}

model UserAchievement {
  id       String           @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime         @default(now())
  badge    AchievementBadge @relation(fields: [badgeId], references: [id])
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
}

model PointTransaction {
  id              String          @id @default(cuid())
  userId          String
  points          Int
  reason          String
  assessmentId    String?
  sampleId        String?
  emotionalDrive  EmotionalDrive?
  multiplier      Float           @default(1.0)
  gameAttributeId String?
  activityLogId   String?
  createdAt       DateTime        @default(now())
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameAttribute   GameAttribute?  @relation(fields: [gameAttributeId], references: [id])
  activityLog     ActivityLog?    @relation(fields: [activityLogId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([gameAttributeId])
  @@index([activityLogId])
}

model GameAttribute {
  id                   String              @id @default(cuid())
  attributeName        String              @unique
  attributeDescription String?
  attributeStatus      String              @default("Active")
  createdAt            DateTime            @default(now())
  points               PointTransaction[]
  rules                GameAttributeRule[]
}

model GameAttributeRule {
  id               String         @id @default(cuid())
  gameAttributeId  String?
  source           String         @default("SAMS")
  eventType        String
  role             String?
  basePoints       Int            @default(0)
  perUnitPoints    Int            @default(0)
  multiplier       Float          @default(1.0)
  conditions       Json?
  dynamicModifiers Json?
  description      String?
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  gameAttribute    GameAttribute? @relation(fields: [gameAttributeId], references: [id], onDelete: Cascade)

  @@index([source])
  @@index([eventType])
  @@index([gameAttributeId])
  @@index([role])
}

model EmotionalDriveMetric {
  id                String   @id @default(cuid())
  userId            String
  period            DateTime
  epicMeaning       Int      @default(0)
  development       Int      @default(0)
  empowerment       Int      @default(0)
  ownership         Int      @default(0)
  socialInfluence   Int      @default(0)
  scarcity          Int      @default(0)
  curiosity         Int      @default(0)
  lossAvoidance     Int      @default(0)
  overallEngagement Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@index([userId])
}

model Milestone {
  id           String    @id @default(cuid())
  userId       String
  title        String
  description  String?
  targetValue  Int
  currentValue Int       @default(0)
  type         String
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([completedAt])
}

enum Role {
  Admin
  Superuser
  Assessor
  Interviewee
}

/// Provider role plane (managed GRA SaaS, Phase 0) — orthogonal to `Role`.
/// A provider may also hold a client-side role inside a specific company.
/// null on `User.providerRole` = not provider staff (no Operator access).
enum ProviderRole {
  ProviderAdmin
  ProviderConsultant
}

model UserRole {
  id                 String            @id @default(cuid())
  uRoleName          String
  uRoleDescription   String?
  uRolePositions     String?
  uRoleReportingLine String?
  companyId          String?
  createdAt          DateTime          @default(now())
  userMappings       UserRoleMapping[]

  @@unique([uRoleName, companyId])
}

model UserRoleMapping {
  id          String   @id @default(cuid())
  userId      String
  userRoleId  String
  remarks     String?
  createdDate DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userRole    UserRole @relation(fields: [userRoleId], references: [id], onDelete: Cascade)

  @@unique([userId, userRoleId])
  @@index([userId])
  @@index([userRoleId])
}

model Company {
  id            String        @id @default(cuid())
  companyID     String        @unique
  companyName   String
  referenceID   String?
  shortName     String?
  createdAt     DateTime      @default(now())
  /// Data Trust Gate (Phase 1, SAMS-003): set on offboarding — hides the
  /// company from selectors and blocks its users' logins. Additive + nullable.
  archivedAt              DateTime?
  /// Data Trust Gate (Phase 1, SAMS-003): set when archive passes to
  /// pending-delete; the safety-net countdown = deletionScheduledAt + 30 days.
  /// Hard delete is MANUAL only (scripts/db/company_hard_delete.ts).
  deletionScheduledAt     DateTime?
  /// White-label theming (Phase 3b, SAMS-010): portal header logo URL (https).
  /// Additive + nullable; included in client-data export (not secret).
  logoUrl                 String?
  /// White-label theming (Phase 3b, SAMS-010): portal accent colour, validated
  /// `^#[0-9a-fA-F]{6}$`. Drives portal accents via a `--brand` CSS variable.
  primaryColor            String?
  /// Outbound Notifications (SAMS-009, Phase 3a, Feature B): per-company
  /// incoming webhook URL (Slack-compatible `{"text": …}`). WRITE-ONLY secret:
  /// settable via the client-Admin portal settings card, MASKED in every API
  /// response, NEVER written to ActivityLog or a digest post, and excluded from
  /// the client-data export (exact name added to EXCLUSION_COLUMNS). Nullable —
  /// null = no webhook configured (no outbound posts for this company).
  notificationWebhookUrl  String?
  /// MIC Ritual (SAMS-014, Phase 4 Feature B): per-company attestation cadence in
  /// days. Additive + nullable — null = quarterly default (90). Due/soon/overdue
  /// states are DERIVED from this + the last attestation (or go-live), never stored.
  attestationCadenceDays  Int?
  userCompanies UserCompany[]
  departments   Department[]
  /// SAMS-013: evidence-chain proposals scoped to this company.
  extractionProposals ExtractionProposal[]
  /// Public read-only API keys scoped to this company (SAMS-011, Phase 3b).
  apiKeys       ApiKey[]
  /// Audit rows for every outbound webhook attempt (SAMS-009). Company-scoped.
  notificationDeliveries  NotificationDelivery[]
  /// MIC attestation records for this company (SAMS-014, Phase 4 Feature B).
  micAttestations MicAttestation[]
}

/// SAMS-011 (Phase 3b, Feature B) — public read-only REST API bearer keys.
/// SCOPE-BY-CONSTRUCTION (settled decision #2): the key's `companyId` IS the
/// query scope — every public v1 endpoint resolves the company from the key and
/// never accepts or honors a company override. Keys are secrets: only the bcrypt
/// `keyHash` is stored; the plaintext bearer is surfaced to the caller ONCE at
/// creation and never stored, logged, or returned again.
///
///   - `label` ≤100 chars (validated at the route layer; free-form for the
///     caller's own reference).
///   - `lastUsedAt` bumps on every successful public v1 request (read-only audit
///     affordance; not required for scope).
///   - `revokedAt` set on revoke; revoked keys are rejected with 403.
///   - **Excluded from the client-data export** (Data Trust Gate): this table is
///     deliberately absent from EXPORT_TABLES in `src/lib/data-trust-export.ts`
///     (keys never travel with client data).
model ApiKey {
  id              String    @id @default(cuid())
  companyId       String
  keyHash         String
  label           String
  createdAt       DateTime  @default(now())
  createdByUserId String?
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdByUser   User?     @relation("ApiKeyCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
}

// ── MIC Ritual (SAMS-014, Phase 4 Feature B) — quarterly attestation records ──
// A first-class record pinning WHAT the client attested — their SOC posture at a
// point in time. `socSnapshot` is SERVER-COMPUTED at signing (never trusted from
// the client); the due/soon/overdue states are DERIVED (no stored flags), so an
// attestation NEVER gates anything (SOFT enforcement). Cadence is per-company
// (null = quarterly default = 90 days) via `Company.attestationCadenceDays`.
model MicAttestation {
  id                String      @id @default(cuid())
  companyId         String
  processAreaId     String
  /// Optional free-form label for the attestation period (e.g. "Q3 2026").
  period            String?
  /// The SPO who signed (client Admin/Assessor/Superuser with company access).
  attestedByUserId  String?
  attestedAt        DateTime    @default(now())
  /// SERVER-COMPUTED SOC snapshot at signing: `{ coveragePct, findingCount,
  /// overdueActionCount }`. Client-supplied values are ignored/overwritten.
  socSnapshot       Json
  company           Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  processArea       ProcessArea @relation(fields: [processAreaId], references: [id], onDelete: Cascade)
  attestedBy        User?       @relation("MicAttestationAttestedBy", fields: [attestedByUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([processAreaId])
  @@index([attestedAt])
}

