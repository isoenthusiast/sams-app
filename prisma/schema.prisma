// ── Risk Management (CSF v2.0 / SRL Integration, 2026-08-06) ────────
model RiskCategory {
  id             String        @id @default(cuid())
  externalId     Int           @unique  // srl.csv ID
  title          String
  level          Int                   // 1=Domain, 2=Category, 3=Risk
  parentId       String?               // self-referencing hierarchy
  domain         String?               // Level-1 name (denormalized)
  category       String?               // Level-2 name (denormalized)
  categoryCode   Int?                  // from srl.csv "N;#Title"
  ranking        Int?                  // Risk Category Ranking (sort key)
  processAreaId  String?               // FK → ProcessArea (Level-3 match)
  parent         RiskCategory?         @relation("RiskCategoryHierarchy", fields: [parentId], references: [id])
  children       RiskCategory[]        @relation("RiskCategoryHierarchy")
  risks          Risk[]

  @@index([level])
  @@index([parentId])
  @@index([processAreaId])
