{
  "version": "1.0.0",
  "note": "Model matrix for the Data Trust Gate isolation suite. Every company-scoped Prisma model must appear here with a `scope` that states how a company filter is applied (direct column `companyId`, or a nested relation traversal). A model missing from this matrix, or added without an entry, FAILS the suite (coverage by construction).",
  "models": {
    "Company":                { "scope": { "kind": "root" }, "label": "Root company" },
    "Standard":               { "scope": { "kind": "direct", "field": "companyId" }, "label": "Management system standards" },
    "AssuranceProtocol":      { "scope": { "kind": "direct", "field": "companyId" }, "label": "Assurance protocols" },
    "ProcessArea":            { "scope": { "kind": "direct", "field": "companyId" }, "label": "Process areas" },
    "SubProcess":             { "scope": { "kind": "direct", "field": "companyId" }, "label": "Sub-processes" },
    "Control":                { "scope": { "kind": "direct", "field": "companyId" }, "label": "Controls" },
    "AssessmentTemplate":     { "scope": { "kind": "direct", "field": "companyId" }, "label": "Assessment templates" },
    "Assessment":             { "scope": { "kind": "direct", "field": "companyId" }, "label": "Assessments" },
    "Attachment":             { "scope": { "kind": "direct", "field": "companyId" }, "label": "Attachments" },
    "UserRole":               { "scope": { "kind": "direct", "field": "companyId" }, "label": "User roles" },
    "Department":             { "scope": { "kind": "direct", "field": "companyId" }, "label": "Departments" },
    "Knowledgebase":          { "scope": { "kind": "direct", "field": "companyId" }, "label": "Knowledgebase entries" },
    "Tag":                    { "scope": { "kind": "direct", "field": "companyId" }, "label": "Tags" },
    "Requirement":            { "scope": { "kind": "direct", "field": "companyId" }, "label": "Requirements" },
    "Document":               { "scope": { "kind": "direct", "field": "companyId" }, "label": "Documents" },
    "BacklogItem":            { "scope": { "kind": "direct", "field": "companyId" }, "label": "Backlog/PIP items" },
    "GamificationStage":      { "scope": { "kind": "direct", "field": "companyId" }, "label": "Gamification stage" },
    "AuditChecklistTemplate": { "scope": { "kind": "direct", "field": "companyId" }, "label": "Audit checklist templates" },
    "RequirementCoverageAudit": { "scope": { "kind": "direct", "field": "companyId" }, "label": "Coverage audit verdicts" },
    "SocStatementAudit":      { "scope": { "kind": "direct", "field": "companyId" }, "label": "SOC statement verdicts" },
    "User":                   { "scope": { "kind": "direct", "field": "companyId" }, "label": "Users (companyId membership)" },
    "UserCompany":            { "scope": { "kind": "direct", "field": "companyId" }, "label": "User-company mappings" },

    "Comment":                { "scope": { "kind": "direct", "field": "companyId" }, "label": "Comments (fabric, visibility-filtered)" },
    "EvidenceRequest":        { "scope": { "kind": "direct", "field": "companyId" }, "label": "Evidence requests (fabric)" },

    "Finding":                { "scope": { "kind": "traverse", "path": ["assessment", "companyId"] }, "label": "Findings (via Assessment)" },
    "Action":                 { "scope": { "kind": "traverse", "path": ["finding", "assessment", "companyId"] }, "label": "Actions (via Finding → Assessment)" },
    "Sample":                 { "scope": { "kind": "traverse", "path": ["assessment", "companyId"] }, "label": "Samples (via Assessment)" },
    "RequirementConclusion":  { "scope": { "kind": "traverse", "path": ["assessment", "companyId"] }, "label": "Requirement conclusions (via Assessment)" },
    "ControlAssignment":      { "scope": { "kind": "traverse", "path": ["assessment", "companyId"] }, "label": "Control assignments (via Assessment)" },
    "AssessmentAssessor":     { "scope": { "kind": "traverse", "path": ["assessment", "companyId"] }, "label": "Assessment assessors (via Assessment)" },
    "Aact":                   { "scope": { "kind": "traverse", "path": ["assessment", "companyId"] }, "label": "Assessment activities (via Assessment)" },
    "AActControls":           { "scope": { "kind": "traverse", "path": ["aact", "assessment", "companyId"] }, "label": "Assessment activity controls (via Aact → Assessment)" },
    "AActUsers":              { "scope": { "kind": "traverse", "path": ["aact", "assessment", "companyId"] }, "label": "Assessment activity users (via Aact → Assessment)" },
    "AActDetails":            { "scope": { "kind": "traverse", "path": ["aact", "assessment", "companyId"] }, "label": "Assessment activity details (via Aact → Assessment)" },
    "MapControl2Requirement": { "scope": { "kind": "traverse", "path": ["control", "companyId"] }, "label": "Control-requirement mappings (via Control)" },
    "MapRequirement2Document": { "scope": { "kind": "traverse", "path": ["document", "companyId"] }, "label": "Requirement-document junctions (via Document)" },
    "ControlSubProcess":      { "scope": { "kind": "traverse", "path": ["control", "companyId"] }, "label": "Control-subprocess junctions (via Control)" },
    "BacklogItemControl":     { "scope": { "kind": "traverse", "path": ["backlogItem", "companyId"] }, "label": "Backlog-control junctions (via BacklogItem)" },
    "AuditChecklistItem":     { "scope": { "kind": "traverse", "path": ["assessment", "companyId"] }, "label": "Audit checklist items (via Assessment)" },
    "AuditChecklist2Requirement": { "scope": { "kind": "traverse", "path": ["requirement", "companyId"] }, "label": "Audit checklist-requirement junctions (via Requirement)" },
    "AuditChecklistTemplateItem": { "scope": { "kind": "traverse", "path": ["template", "companyId"] }, "label": "Audit checklist template items (via Template)" },
    "AssessmentChecklistControl": { "scope": { "kind": "traverse", "path": ["assessment", "companyId"] }, "label": "Checklist-control junctions (via Assessment)" },
    "Risk":                   { "scope": { "kind": "traverse", "path": ["processArea", "companyId"] }, "label": "Risks (via ProcessArea)" },
    "RiskMetrics":            { "scope": { "kind": "traverse", "path": ["risk", "processArea", "companyId"] }, "label": "Risk metrics (via Risk → ProcessArea)" },
    "RiskCategory":           { "scope": { "kind": "traverse", "path": ["processArea", "companyId"] }, "label": "Risk categories (via ProcessArea)" },
    "ControlRisk":            { "scope": { "kind": "traverse", "path": ["control", "companyId"] }, "label": "Control-risk junctions (via Control)" },
    "Position":               { "scope": { "kind": "traverse", "path": ["department", "companyId"] }, "label": "Positions (via Department)" },
    "UserAchievement":        { "scope": { "kind": "traverse", "path": ["user", "companyId"] }, "label": "User achievements (via User)" },
    "PointTransaction":       { "scope": { "kind": "traverse", "path": ["user", "companyId"] }, "label": "Point transactions (via User)" },
    "UserRoleMapping":        { "scope": { "kind": "traverse", "path": ["userRole", "companyId"] }, "label": "User-role mappings (via UserRole)" }
  }
}
